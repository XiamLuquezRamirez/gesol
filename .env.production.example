# =============================================================
#  Gesol — plantilla de entorno para PRODUCCION
#  Copia este archivo a .env EN EL SERVIDOR y rellena los valores
#  marcados con <...>. NO subas el .env real al repositorio.
# =============================================================

APP_NAME=Gesol
APP_ENV=production
# Genera una clave nueva en el servidor con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# URL publica real (con https). Debe coincidir con el dominio del sitio.
APP_URL=https://<tu-dominio>

# --- Logs ---
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# En produccion registra solo lo relevante (no 'debug').
LOG_LEVEL=error

# --- Base de datos (MariaDB/MySQL del hosting) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nombre_bd>
DB_USERNAME=<usuario_bd>
DB_PASSWORD=<password_bd>

# --- Cache / sesion / cola ---
# Autenticacion por sesion (Breeze/Inertia). 'database' es seguro y no requiere Redis.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# 'file' no requiere tabla ni Redis (este proyecto no tiene migracion de sessions).
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Correo (para el envio de liquidaciones/anexos) ---
# Ajusta al SMTP real del hosting o proveedor (p. ej. cPanel, Gmail, Mailgun).
MAIL_MAILER=smtp
MAIL_HOST=<smtp_host>
MAIL_PORT=587
MAIL_USERNAME=<smtp_usuario>
MAIL_PASSWORD=<smtp_password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<no-reply@tu-dominio>
MAIL_FROM_NAME="${APP_NAME}"

# --- No se usan en este proyecto (dejar por defecto) ---
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
